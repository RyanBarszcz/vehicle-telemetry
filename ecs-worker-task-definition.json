{
  "family": "driveiq-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::795176248415:role/driveiqEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::795176248415:role/driveiqWorkerTaskRole",
  "containerDefinitions": [
    {
      "name": "driveiq-worker",
      "image": "795176248415.dkr.ecr.us-east-2.amazonaws.com/driveiq-worker:latest",
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "telem-project-795176248415-us-east-2-an"
        },
        {
          "name": "SQS_TELEMETRY_QUEUE_URL",
          "value": "https://sqs.us-east-2.amazonaws.com/795176248415/driveiq-telemetry-processing"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://telemetry.ryanbarszcz.com"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:795176248415:secret:driveiq/backend/production-mZ0IWC:DATABASE_URL::"
        },
        {
          "name": "CLERK_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:795176248415:secret:driveiq/backend/production-mZ0IWC:CLERK_SECRET_KEY::"
        },
        {
          "name": "CLERK_JWKS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:795176248415:secret:driveiq/backend/production-mZ0IWC:CLERK_JWKS_URL::"
        },
        {
          "name": "CLERK_ISSUER",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:795176248415:secret:driveiq/backend/production-mZ0IWC:CLERK_ISSUER::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/driveiq-worker",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
